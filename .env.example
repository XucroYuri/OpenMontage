# OpenMontage 环境变量示例
# 将本文件复制为 .env，再填写所需密钥。不要提交包含真实密钥的 .env。

# --- 图像与视频网关 ---
# 用于 FLUX 图像、Google Veo 视频、Kling 视频、MiniMax 视频和 Recraft 图像。
# 获取密钥：https://fal.ai/dashboard/keys
FAL_KEY=
# FAL_KEY 的别名（部分 SDK/文档使用此名称）；配置任意一个即可。
FAL_AI_API_KEY=

# --- MiniMax 官方直连 API ---
# 用于官方图像生成，以及 MiniMax H3 / 旧版 Hailuo 视频生成。
# 获取密钥：https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=
# 可选：global（默认）或 cn。
MINIMAX_REGION=global
# 可选端点覆盖；通常留空，由 MINIMAX_REGION 自动选择。
# MINIMAX_BASE_URL=

# --- Replicate ---
# 用于 Replicate 托管的视频生成（seedance_replicate），使基于 Replicate 的
# Seedance 路径可以与 fal.ai 路径同时参与选择。
# 获取密钥：https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Higgsfield ---
# Higgsfield Cloud（higgsfield_video）的 key。请与下一行 secret 配套使用，
# 也可以改用 HIGGSFIELD_KEY="<key>:<secret>" 的组合形式。
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HIGGSFIELD_KEY=            # 可选组合格式 key:secret；使用它时无需填写上面的 _KEY/_SECRET。

# --- Kling 官方直连 API ---
# Kling 官方 API 密钥；启用视频、图像、TTS、avatar 和 lip sync。
KLING_API_KEY=
# 可选端点覆盖；留空时使用 https://api-singapore.klingai.com
# 中国大陆账号可使用 https://api-beijing.klingai.com
KLING_API_BASE_URL=

# --- Google（一个密钥启用图像生成、TTS 和视频）---
# 用于 Google Imagen 图像、Google Cloud TTS（700 多种声音、50 多种语言），
# 以及 Gemini Omni 视频（生成与对话式编辑，付费能力）。
# 获取密钥：https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # GOOGLE_API_KEY 的别名；两者同时存在时优先使用此项。
# API 密钥的替代方案：服务账号 JSON 身份验证。
# TTS 使用 Cloud Text-to-Speech；Imagen 路由到 Vertex AI。
# 服务账号 JSON 密钥文件路径。
GOOGLE_APPLICATION_CREDENTIALS=
# GCP project id（通过 Vertex AI 使用 Imagen 时必填）。
GOOGLE_CLOUD_PROJECT=
# Vertex AI 区域，默认 us-central1。
GOOGLE_CLOUD_LOCATION=

# --- 语音与音频 ---
# 用于 TTS 旁白、音乐生成和音效。
ELEVENLABS_API_KEY=
# OpenAI TTS 后备方案和 GPT Image 2 图像生成。
OPENAI_API_KEY=
# Grok 图像生成/编辑和 Grok 视频生成。
XAI_API_KEY=
# 火山引擎豆包语音 TTS（新版控制台 API Key）。
DOUBAO_SPEECH_API_KEY=
# 豆包默认说话人/音色，例如 zh_female_vv_uranus_bigtts。
DOUBAO_SPEECH_VOICE_TYPE=
# fish.audio TTS（s1 / s2-pro / s2.1-pro，支持 reference_id 声音克隆）。
FISH_AUDIO_API_KEY=
# Piper 本地音色不需要环境变量；通过 pip 安装 `piper-tts`。

# --- DashScope（阿里云百炼）---
# 用于 Qwen 图像生成（qwen-image-2.0-pro）、TTS（qwen3-tts-flash）和带词级时间戳的 ASR（qwen3-asr-flash-filetrans）。
# 获取密钥：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=

# --- 腾讯混元 TokenHub API ---
# 通过 TokenHub（Bearer token）使用腾讯混元图像和云端视频生成。
# 获取密钥：https://console.cloud.tencent.com/tokenhub
TENCENT_TOKENHUB_API_KEY=

# --- 音乐 ---
# Suno AI 音乐生成（完整歌曲、纯音乐和多种风格）。
SUNO_API_KEY=

# --- 视频生成 ---
# 火山引擎方舟 Seedance 2.0 / 2.5 直连 API key 正文（不含 "Bearer " 前缀）。
# 获取密钥：https://console.volcengine.com/ark/region:cn-beijing/apiKey
ARK_API_KEY=
# 可选覆盖项；仅在需要时取消注释。
# ARK_SEEDANCE_MODEL=doubao-seedance-2-5-260628
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_CNY_PER_USD=7.2
# HeyGen API（一个密钥使用 VEO、Sora、Runway、Kling 和 Seedance）。
HEYGEN_API_KEY=
# Runway Gen-4（直连 API，可替代 fal.ai 路由）。
RUNWAY_API_KEY=
# 火山引擎即梦 AI 官方视频生成 API（HMAC-SHA256 V4 签名）。
VOLC_ACCESSKEY=
# 与 VOLC_ACCESSKEY 配套的 Secret Access Key。获取地址：https://console.volcengine.com/iam/keymanage
VOLC_SECRETKEY=
# 设为 "true" 启用本地视频生成（需要 GPU 和 diffusers）。
VIDEO_GEN_LOCAL_ENABLED=
# 本地模型：wan2.1-1.3b、wan2.1-14b、hunyuan-1.5、ltx2-local、cogvideo-5b。
VIDEO_GEN_LOCAL_MODEL=
# Modal 自托管 LTX-2 端点（可选）。
MODAL_LTX2_ENDPOINT_URL=

# ComfyUI 服务器覆盖项（可选；默认共享服务器为 localhost:8188）。
# Partner Nodes 仍需要网络、已登录的 Comfy 账号和可用点数。
COMFYUI_SERVER_URL=
COMFYUI_VIDEO_SERVER_URL=

# --- 库存媒体 ---
# Pexels 库存视频/图像（免费）。
PEXELS_API_KEY=
# Pixabay 库存视频/图像（免费）。
PIXABAY_API_KEY=
# Unsplash 库存图像（免费开发者密钥）。
UNSPLASH_ACCESS_KEY=

# --- 分析 ---
# HuggingFace token；为 transcriber 启用说话人分离。
HF_TOKEN=
# 可选 Azure AI Speech；一组 key/region 同时启用两个方向：
# azure_stt（Fast Transcription 云端 STT）和 azure_tts（神经语音云端 TTS）。
# 本地 faster-whisper transcriber / piper_tts 仍是默认离线路径。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=     # 可选：完整自定义 STT 端点 URL（覆盖 region）
# AZURE_TTS_ENDPOINT=        # 可选：完整自定义 TTS 主机（例如 https://<region>.tts.speech.microsoft.com）

# --- Avatar（本地安装）---
# WAV2LIP_PATH=              # 已克隆 Wav2Lip 仓库的路径（用于 lip sync）
# SADTALKER_PATH=            # 已克隆 SadTalker 仓库的路径（用于 talking-head avatar）
